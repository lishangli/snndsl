root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# trailing spaces are meaningful in Markdown (hard line breaks)
trim_trailing_whitespace = false

[*.snn]
indent_size = 4
